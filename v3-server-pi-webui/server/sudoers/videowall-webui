# Installed as /etc/sudoers.d/videowall-webui by install.sh.
#
# One line, because the web UI's only privileged need is controlling the
# templated encoder units — and with dynamic wall names those can't be
# enumerated here the way the old fixed 4k/1080p pair was.
#
# The wildcard is safe because it does not grant arbitrary systemctl access:
# it grants exactly one root-owned script, and that script validates its verb
# against an allowlist and its wall name against a strict slug pattern (no
# dots, slashes or whitespace) before touching systemd. Keep
# /usr/local/sbin/videowall-ctl root-owned and NOT writable by videowall-web,
# or this stops being a gate.
videowall-web ALL=(root) NOPASSWD: /usr/local/sbin/videowall-ctl *
