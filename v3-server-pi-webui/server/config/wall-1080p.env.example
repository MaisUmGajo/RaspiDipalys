# Per-wall settings for the 1080p/2x2 mosaic.
# Copied to /etc/videowall/wall-1080p.env by install.sh, and editable
# afterwards either by hand or via the web UI's Config page (the web UI
# rewrites this file in this same normalized format each time you save —
# any extra hand-added comments will be replaced).
#
# Changing ROWS/COLS changes how many camera URLs cameras-1080p.conf must
# contain (ROWS*COLS) — the encode script and the web UI both validate
# this before (re)starting.

ROWS=2
COLS=2
CANVAS_W=1920
CANVAS_H=1080

# SRT port this wall is published on (must match the Pi's pi.env PORT_1080P).
PORT=6001

# Encode bitrate in kbps and target framerate. These are the main levers
# for fitting this wall's bandwidth through a constrained uplink (e.g. a
# cross-site Tailscale connection) — see the main README's "Connecting
# server and Pi across sites" section.
BITRATE_KBPS=4000
FPS=15

CAMERAS_FILE=/etc/videowall/cameras-1080p.conf
