# Per-wall settings. One of these files per wall, named wall-<slug>.env, in
# /etc/videowall/. The slug is the wall's identity: it names the systemd
# instance (videowall-encode@<slug>.service) and the MediaMTX path clients
# subscribe to. Valid slugs: lowercase alphanumeric start, then
# alphanumerics/underscore/hyphen, max 32 chars.
#
# Editable by hand or from the web UI's Config page (the web UI rewrites this
# file in this same normalized format on every save, so hand-added comments
# will be replaced). The UI can also create and delete walls, so you only need
# to copy this file manually if you prefer working over SSH.
#
# Changing ROWS/COLS changes how many camera URLs CAMERAS_FILE must contain
# (exactly ROWS*COLS) — both the encode script and the web UI validate this.

# Set to false to keep this wall configured but not running. The web UI's
# enable/disable toggle writes this, stops/disables the systemd instance, and
# leaves everything else intact. The encode script also refuses to start a
# disabled wall, so a stray manual start can't contradict the UI.
ENABLED=true

ROWS=3
COLS=3
CANVAS_W=3840
CANVAS_H=2160

# Encode bitrate in kbps and target framerate — the main levers for fitting
# this wall through a constrained uplink (e.g. a cross-site Tailscale link).
# There is deliberately no port setting: the wall is published to MediaMTX
# under its own name, and every client reads from one shared SRT port.
BITRATE_KBPS=8000
FPS=15

CAMERAS_FILE=/etc/videowall/cameras-4k.conf
