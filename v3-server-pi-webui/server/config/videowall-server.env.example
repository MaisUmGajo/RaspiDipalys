# Global settings, shared by both walls. Sourced by
# /opt/videowall/bin/videowall-encode.sh on every (re)start, after the
# per-wall wall-<name>.env file. Copied to /etc/videowall/videowall-server.env
# by install.sh, editable by hand or via the web UI's Config page (the web
# UI rewrites this file in this same normalized format each time you save).

# RTSP transport used when pulling from the cameras. tcp is more resilient
# over routed networks; udp has lower overhead but shows artifacts on loss.
RTSP_TRANSPORT=tcp

# SRT latency budget in milliseconds — the buffering SRT uses to recover
# from packet loss/reordering between server and Pi. 200ms is plenty on a
# wired LAN; if server and Pi are at different sites (e.g. connected over
# Tailscale), start around 400ms and raise further if you see stuttering.
# This MUST match SRT_LATENCY_MS in the Pi's pi.env on both walls.
SRT_LATENCY_MS=400

# Which encoder to use:
#
#   none   software libx264 (default — works on any server, no GPU needed)
#   vaapi  Intel/AMD GPU via VAAPI. Needs /dev/dri/renderD128 to exist and
#          VAAPI drivers installed.
#   nvenc  NVIDIA GPU via NVENC. Needs the NVIDIA driver loaded — check
#          `nvidia-smi` works before switching. Debian's ffmpeg already
#          includes h264_nvenc.
#
# WHEN YOU NEED ONE: software encoding a 3x3 mosaic onto a 4K canvas is
# expensive — measured at roughly 0.5x realtime (7 of the target 15 fps) on
# a 6-core Xeon E5-2630. Running below realtime is not merely "a bit choppy":
# ffmpeg keeps reading the cameras in real time while falling behind, so its
# buffers grow without limit until the kernel OOM-kills it. Observed reaching
# 15.5 GB resident before dying. Either give the wall an encoder that keeps
# up, or shrink the canvas — a 1920x1080 wall measured 1.01x on that same CPU.
#
# A 1080p wall in software is fine on modest hardware. A 4K wall in software
# is not; use vaapi/nvenc or reduce CANVAS_W/CANVAS_H.
HWACCEL=none

# Deprecated, kept so existing installs keep working: VAAPI=1 is equivalent
# to HWACCEL=vaapi. HWACCEL wins if both are set.
VAAPI=0

# VAAPI only: render node to use, if not the default.
#VAAPI_DEVICE=/dev/dri/renderD128

# NVENC only. Presets run p1 (fastest) to p7 (best quality); p4 is a middle
# setting that stays comfortably realtime for a 4K mosaic. Tune ll = low
# latency, ull = ultra low latency, hq = quality.
#NVENC_PRESET=p4
#NVENC_TUNE=ll
# Pick a specific GPU when the machine has more than one.
#NVENC_DEVICE=0
# Also decode the cameras on the GPU (NVDEC), not just encode. Off by default:
# the encode is what dominates at 4K, the mosaic filter still runs on the CPU
# so frames come back to system memory anyway, and a driver too old for a
# given camera's stream would fail that input outright.
#NVDEC=0
