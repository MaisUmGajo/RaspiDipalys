# Global settings, shared by every wall. Sourced by
# /opt/videowall/bin/videowall-encode.sh after the per-wall wall-<name>.env.
# Copied to /etc/videowall/videowall-server.env by install.sh; editable by
# hand or via the web UI's Config page (which rewrites it in this format).

# RTSP transport used when pulling from the cameras. tcp is more resilient
# over routed networks; udp has lower overhead but shows artifacts on loss.
# The web UI's per-camera probe uses this same value, so its results reflect
# what the encoder actually does rather than ffprobe's UDP-first default.
RTSP_TRANSPORT=tcp

# SRT latency budget in milliseconds, advertised to clients. This is the
# buffering used to recover from packet loss/reordering between the relay and
# a client. 200ms is plenty on a wired LAN; for a cross-site link (e.g. over
# Tailscale) start around 400 and raise it if you see stuttering. Clients
# should request the same value.
SRT_LATENCY_MS=400

# Encode via VAAPI hardware acceleration (1) if the server has a supported
# Intel iGPU, or software libx264 (0, default — works on any server
# regardless of GPU). Only flip to 1 once you've confirmed
# /dev/dri/renderD128 exists and VAAPI drivers are installed.
VAAPI=0

# --- MediaMTX relay ---------------------------------------------------------
# Encoders publish into MediaMTX over loopback RTSP; clients subscribe over
# SRT. This is what allows more than one Pi to consume the same wall (a raw
# ffmpeg SRT listener accepts exactly one connection).
# Publish target (loopback only — MediaMTX is configured not to accept
# publishes from the network).
MEDIAMTX_RTSP_HOST=127.0.0.1
MEDIAMTX_RTSP_PORT=8554
# MediaMTX's read-only HTTP API, used by the web UI to report real per-client
# stats (address, uptime, bytes) instead of inferring them.
MEDIAMTX_API=http://127.0.0.1:9997

# --- Mosaic snapshot --------------------------------------------------------
# Writes a periodically-refreshed JPEG of each wall's composited mosaic into
# the runtime dir, tee'd off the existing encode pipeline (no extra camera
# connections, no extra decoding). The web UI shows it with a cell-grid
# overlay so you can confirm the layout without a monitor attached.
# SNAPSHOT is a kill switch: set to 0 if the extra output ever destabilises an
# encode, and the pipeline reverts to exactly its previous shape.
SNAPSHOT=1
# Width of the JPEG in pixels (height follows the mosaic's aspect ratio).
# Don't go much below this: at 640 a 3x3 grid gives 213x120 cells, too coarse
# to judge anything but "black or not".
SNAPSHOT_WIDTH=1280
# Seconds between snapshot frames. The rate limit is applied inside the filter
# graph, so skipped frames cost nothing.
SNAPSHOT_INTERVAL_S=5
