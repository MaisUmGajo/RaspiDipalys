[Unit]
Description=MediaMTX relay for the video wall (fans each wall out to N clients)
After=network-online.target
Wants=network-online.target
# The encoders publish into this, so it should be up first. They retry anyway
# (Restart=always), so this is an optimisation rather than a hard dependency.
Before=videowall-encode@.service

[Service]
Type=simple
User=videowall
Group=videowall
ExecStart=/usr/local/bin/mediamtx /etc/videowall/mediamtx.yml
Restart=always
RestartSec=5
# It only needs to listen and relay: no filesystem writes, no privileges.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
