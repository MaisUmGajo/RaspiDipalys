[Unit]
Description=Video wall - 1080p (2x2) composite encoder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=videowall
Group=videowall
RuntimeDirectory=videowall
RuntimeDirectoryMode=0755
ExecStart=/opt/videowall/bin/videowall-encode.sh 1080p
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
