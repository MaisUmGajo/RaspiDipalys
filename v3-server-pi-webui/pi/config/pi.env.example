# Raspberry Pi display client settings.
# Rewritten by the Pi web UI on every save. Each display loop in
# ~videowall/.xinitrc re-reads this file on every reconnect, so applying a
# change just restarts the mpv processes (the web UI's "Apply" button).

# Hostname or IP of the server running the MediaMTX relay. If server and Pi
# are on different sites connected via Tailscale, use the server's Tailscale
# IP (100.x.y.z) or MagicDNS name — it stays valid regardless of which
# physical network either box is on.
SERVER_HOST=192.168.1.50

# The relay's SRT port. All walls share this one port; a wall is selected by
# name via the SRT stream id, so there are no per-wall ports to keep in sync.
MEDIAMTX_SRT_PORT=8890

# Which wall each HDMI output shows, by name. These must match wall names on
# the server (the web UI offers a dropdown of them). Leave one blank to leave
# that output unused.
#   OUTPUT1 = screen :0.0 = HDMI0 (the port nearest the USB-C power input)
#   OUTPUT2 = screen :0.1 = HDMI1
OUTPUT1_WALL=4k
OUTPUT2_WALL=1080p

# Read-only API token issued by the server's installer, used only to fetch the
# list of walls for the picker. Deliberately not the server's admin password.
# Leave blank to enter wall names by hand instead.
SERVER_API_TOKEN=

# Must match SRT_LATENCY_MS on the server.
SRT_LATENCY_MS=400

# mpv hardware decode mode. v4l2m2m-copy is the safe default under X11.
# Since the Pi only decodes ONE already-composited stream per screen, you can
# try the zero-copy "v4l2m2m" for lower CPU — fall back to "-copy" if a screen
# stays blank or artifacts appear.
HWDEC=v4l2m2m-copy
