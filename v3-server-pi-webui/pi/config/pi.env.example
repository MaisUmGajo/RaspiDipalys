# Raspberry Pi display client settings.
# Rewritten by the Pi web UI on every save. Each display loop in
# ~videowall/.xinitrc re-reads this file on every reconnect, so applying a
# change just restarts the mpv processes (the web UI's "Apply" button).

# Hostname or IP of the server running the MediaMTX relay. If server and Pi
# are on different sites connected via Tailscale, use the server's Tailscale
# IP (100.x.y.z) or MagicDNS name — it stays valid regardless of which
# physical network either box is on.
SERVER_HOST=192.168.1.50

# The relay's SRT port. All walls share this one port; a wall is selected by
# name via the SRT stream id, so there are no per-wall ports to keep in sync.
MEDIAMTX_SRT_PORT=8890

# Which wall each HDMI output shows, by name. These must match wall names on
# the server (the web UI offers a dropdown of them). Leave one blank to leave
# that output unused.
#   OUTPUT1 = screen :0.0 = HDMI0 (the port nearest the USB-C power input)
#   OUTPUT2 = screen :0.1 = HDMI1
OUTPUT1_WALL=4k
OUTPUT2_WALL=1080p

# Read-only API token issued by the server's installer, used only to fetch the
# list of walls for the picker. Deliberately not the server's admin password.
# Leave blank to enter wall names by hand instead.
SERVER_API_TOKEN=

# Must match SRT_LATENCY_MS on the server.
SRT_LATENCY_MS=400

# mpv hardware decode mode. v4l2m2m-copy is the safe default under X11 and
# genuinely engages the Pi's VideoCore decoder. Note that mpv's "auto"/
# "auto-safe" does NOT pick the Pi's V4L2 decoder — it only probes desktop
# hwdecs — so it silently falls back to software decoding. Since the Pi only
# decodes ONE already-composited stream per screen, you can try the zero-copy
# "v4l2m2m" for lower CPU; fall back to "-copy" if a screen stays blank or
# artifacts appear.
HWDEC=v4l2m2m-copy

# How long mpv waits on a stalled network read before giving up, in seconds.
# When it does give up, mpv exits and the display loop reconnects.
NET_TIMEOUT_S=30

# --- Self-heal watchdog -----------------------------------------------------
# The display loops only react when mpv EXITS. These settings catch the
# failures where mpv keeps running but the picture is wrong: a frozen stream,
# one degraded to a fraction of real time, or a corrupt one. Recovery is an
# in-place reconnect (no black screen, no process restart).
#
# Seconds between checks. Set to 0 to disable the watchdog entirely.
WATCHDOG_INTERVAL_S=15

# Reconnect a stream whose playback advances below this fraction of real time
# (0.5 = half speed). 0 disables just this check. A fully frozen stream is
# rate 0 and is caught by the same rule.
STALL_RATE=0.5

# ...but only after this many CONSECUTIVE slow checks. A single dip on a
# congested link is normal, and reconnecting on it would thrash — which
# matters more here than on a LAN, since the server link may cross sites.
STALL_STRIKES=2

# Reconnect when the decoder's dropped-frame count jumps by at least this much
# between checks — a corrupt picture that keeps "playing" and so is invisible
# to every other health signal. Reconnecting forces a fresh keyframe.
ERROR_RELOAD_THRESHOLD=10
