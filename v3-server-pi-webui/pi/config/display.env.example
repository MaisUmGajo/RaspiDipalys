# Physical display layout for the Pi's two HDMI outputs.
# Copied to /etc/videowall/display.env by install.sh and sourced once by
# ~videowall/.xinitrc when X starts.
#
# WHY THIS IS A SEPARATE FILE FROM pi.env: the web UI rewrites pi.env from a
# fixed template on every save (see PI_ENV_TEMPLATE in pi/webui/app.py), so
# any extra key added there would be silently dropped the first time someone
# pressed Save. Settings the web UI does not manage therefore live here.
#
# Changing these takes effect on the next X restart (reboot, or
# `systemctl restart getty@tty1`), not via the web UI's Apply button — that
# only restarts mpv, and the screen layout is established before mpv runs.

# Mode for each output, as xrandr spells it (e.g. 3840x2160). Output A is the
# first connected output xrandr reports and shows the 4K/PORT_4K wall; output
# B is the second and shows the PORT_1080P wall, placed to the right of A.
#
# Leave EMPTY to let xrandr choose with --auto. Be aware that --auto is only
# trustworthy when the driver advertises a preferred mode: on a Pi 4 with
# vc4-kms-v3d the "+preferred" flag disappears from `xrandr --verbose` once a
# mode has been set, after which --auto can silently settle on something much
# smaller (observed: two 4K panels both dropping to 1920x1080). Setting the
# mode explicitly avoids depending on that.
#
# These panels also advertise 4096x2160 (DCI 4K, 17:9) above the usual
# 3840x2160 (UHD, 16:9). Picking "the largest mode" would therefore select a
# non-native aspect ratio on a 16:9 TV, which is the other reason this is
# explicit rather than inferred.
#
# If the mode named here is not available on that output, .xinitrc falls back
# to --auto rather than leaving the screen unconfigured.
DISPLAY_MODE_A=3840x2160
DISPLAY_MODE_B=3840x2160
