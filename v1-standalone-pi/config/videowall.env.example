# Sourced by /opt/videowall/bin/videowall-grid.sh on every (re)start.
# Copied to /etc/videowall/videowall.env by install.sh.

# Target framerate for the composited wall. CCTV monitoring doesn't need
# 30/60fps; lowering this is the single biggest lever for reducing CPU/GPU
# load if the Pi struggles to keep up with many streams at once.
FPS=12

# Use the Pi 4's V4L2 M2M hardware H.264 decoder (1) or fall back to
# software decode via libavcodec (0). Try 1 first; if streams stutter or
# ffmpeg logs v4l2m2m errors with many cameras open at once, set this to 0
# — software decode of small, low-fps streams is often more reliable in
# practice than pushing many concurrent sessions through the single shared
# hardware decoder block.
HWDECODE=1

# RTSP transport. tcp is more resilient over Wi-Fi/routed networks; udp has
# lower overhead but will show artifacts on any packet loss.
RTSP_TRANSPORT=tcp
