# Sourced by ~videowall/.xinitrc on every (re)start.
# Copied to /etc/videowall/pi.env by install.sh.

# Hostname or IP of the Debian encoding server. If server and Pi are on
# different sites connected via Tailscale, use the server's Tailscale IP
# (100.x.y.z) or MagicDNS name here instead of a LAN IP — it stays valid
# regardless of which physical network either box is on.
SERVER_HOST=192.168.1.50

# Must match the ports the server's videowall-encode-*.service units publish
# on (see /etc/systemd/system/videowall-encode-*.service on the server).
PORT_4K=6000
PORT_1080P=6001

# Must match SRT_LATENCY_MS in the server's videowall-server.env exactly.
SRT_LATENCY_MS=400

# mpv hardware decode mode. v4l2m2m-copy is the safe default under X11.
# Since the Pi now only decodes ONE already-composited stream per screen
# (no local scaling/compositing at all), you can try the zero-copy
# "v4l2m2m" mode for lower CPU use — fall back to "-copy" if a screen stays
# blank or artifacts appear.
HWDEC=v4l2m2m-copy
