# Sourced by /opt/videowall/bin/videowall-encode.sh on every (re)start.
# Copied to /etc/videowall/videowall-server.env by install.sh.

# Framerate of the composited mosaics. Lower this first if the server's CPU
# can't keep up with 13 concurrent decodes + 2 encodes.
FPS=15

# RTSP transport used when pulling from the cameras. tcp is more resilient
# over routed networks; udp has lower overhead but shows artifacts on loss.
RTSP_TRANSPORT=tcp

# SRT latency budget in milliseconds. This is the buffering SRT uses to
# recover from packet loss/reordering between server and Pi — higher values
# tolerate worse networks at the cost of extra end-to-end delay. 200ms is
# plenty on a wired LAN; if server and Pi are at different sites (e.g.
# connected over Tailscale), start around 400ms and raise further if you
# see stuttering — this MUST match SRT_LATENCY_MS in the Pi's pi.env.
SRT_LATENCY_MS=400

# Encode via VAAPI hardware acceleration (1) if the server has a supported
# Intel iGPU, or software libx264 (0, default — works on any server
# regardless of GPU). Try 0 first; only flip to 1 if you've confirmed
# /dev/dri/renderD128 exists and VAAPI drivers are installed, and want to
# free up CPU headroom.
VAAPI=0
